{
  "id": null,
  "uid": "f1-telemetry-main",
  "title": "F1 Telemetry",
  "tags": ["f1", "telemetry"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "session",
        "label": "Sesión",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(f1_simulation_events_published_total, session_key)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Simulation Status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_simulation_status{status=\"RUNNING\", session_key=~\"$session\"}",
          "legendFormat": "Session {{session_key}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "STOPPED", "color": "red" }, "1": { "text": "RUNNING", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events Published",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_simulation_events_published_total{session_key=~\"$session\"}",
          "legendFormat": "Session {{session_key}}"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events Processed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_simulation_events_processed_total{session_key=~\"$session\"}",
          "legendFormat": "Session {{session_key}}"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } } }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Driver Speed (km/h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_speed_kmh{session_key=~\"$session\"}",
          "legendFormat": "{{driver_name}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 400,
          "unit": "velocitykmh",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 250 },
              { "color": "red", "value": 330 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Clasificación",
      "gridPos": { "h": 12, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_position{session_key=~\"$session\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "session_key": true,
              "driver_number": true
            },
            "renameByName": { "driver_name": "Piloto", "Value": "Pos" }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Pos", "desc": false }] }
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Pos" }, "properties": [{ "id": "custom.width", "value": 60 }, { "id": "decimals", "value": 0 }] }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Driver Speed Over Time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_speed_kmh{session_key=~\"$session\"}",
          "legendFormat": "{{driver_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": { "defaults": { "unit": "velocitykmh" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Posiciones en carrera (P1 arriba)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_position{session_key=~\"$session\"}",
          "legendFormat": "{{driver_name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "asc" }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "transform": "negative-Y",
            "axisLabel": "Posición"
          }
        }
      }
    }
  ]
}
