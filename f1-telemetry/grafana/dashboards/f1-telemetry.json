{
  "id": null,
  "uid": "f1-telemetry-main",
  "title": "F1 Telemetry",
  "tags": ["f1", "telemetry"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Simulation Status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_simulation_status{status=\"RUNNING\"}",
          "legendFormat": "Session {{session_key}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "STOPPED", "color": "red" }, "1": { "text": "RUNNING", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events Published",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_simulation_events_published_total",
          "legendFormat": "Session {{session_key}}"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events Processed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_simulation_events_processed_total",
          "legendFormat": "Session {{session_key}}"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } } }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Driver Speed (km/h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_speed_kmh",
          "legendFormat": "Driver {{driver_number}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 400,
          "unit": "velocitykmh",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 250 },
              { "color": "red", "value": 330 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Driver Positions",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_position",
          "legendFormat": "Driver {{driver_number}}",
          "instant": true
        }
      ],
      "options": { "sortBy": [{ "displayName": "Value", "desc": false }] },
      "fieldConfig": { "defaults": { "custom": { "displayMode": "basic" } } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Driver Speed Over Time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_speed_kmh",
          "legendFormat": "Driver {{driver_number}}"
        }
      ],
      "options": { "legend": { "displayMode": "list" } },
      "fieldConfig": { "defaults": { "unit": "velocitykmh" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Driver Gap (seconds)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "f1_driver_gap_seconds",
          "legendFormat": "Driver {{driver_number}}"
        }
      ],
      "options": { "legend": { "displayMode": "list" } },
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
